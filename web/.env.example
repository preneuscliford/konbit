# Copier en .env.local (et dans les variables d'environnement Vercel).
# Clé PUBLIQUE uniquement : jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresse publique du site, sans / final (http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=https://konbit509.app
# Client OAuth Google « Web » (même que EXPO_PUBLIC_WEB_CLIENT_ID de l app)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
